# E2E demo-account credentials for the Playwright suite.
# Copy this file to .env.e2e (gitignored) and fill in the real values:
#   Copy-Item .env.e2e.example .env.e2e
# playwright.config.ts loads .env.e2e automatically; real env vars win.
E2E_TENANT_EMAIL=your-tenant-demo-email@example.com
E2E_TENANT_PASSWORD=your-tenant-demo-password
E2E_LANDLORD_EMAIL=your-landlord-demo-email@example.com
E2E_LANDLORD_PASSWORD=your-landlord-demo-password
